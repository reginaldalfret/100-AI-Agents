{
  "name": "super-ai-workbench",
  "version": "2.0.0",
  "description": "Super AI (Sovereign AI Workbench) - 100% On-Premise Industrial Autonomous Agentic Platform",
  "type": "module",
  "main": "platform/gateway/src/server.js",
  "scripts": {
    "start": "node platform/gateway/src/server.js",
    "test": "node tests/sih/run-all-tests.js",
    "test:sih": "node tests/sih/run-all-tests.js",
    "test:fleet": "node tests/run-all-agents.js --concurrency=10",
    "test:ui": "node tests/sih/ui/composer-ui.test.js && node tests/ui/model-selector.test.js && node tests/ui/agent-numbering.test.js",
    "benchmark": "node scripts/benchmark/run-model-benchmark.js",
    "fleet:start": "node scripts/run-fleet.js",
    "supervisor": "node scripts/supervisor.js",
    "desktop:test": "node --test tests/desktop/*.test.js",
    "test:personal-style": "node --test tests/personal-style/*.test.js",
    "desktop:start": "node desktop/main/main.js",
    "test:deployment": "node --test tests/deployment/*.test.js",
    "dev:next": "next dev platform/web",
    "build:next": "next build platform/web",
    "start:next": "next start platform/web",
    "test:next": "node --test tests/nextjs-migration/*.test.js"
  },
  "keywords": [
    "super-ai",
    "sovereign-ai",
    "industrial-agents",
    "air-gapped",
    "autonomous-planning",
    "local-llm"
  ],
  "author": "Smart India Hackathon Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^7.0.2"
  }
}
