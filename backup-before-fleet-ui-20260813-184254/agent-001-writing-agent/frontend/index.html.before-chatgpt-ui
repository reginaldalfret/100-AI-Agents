<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{AGENT_NAME}}</title>

  <style>
    :root {
      --bg: #212121;
      --sidebar: #171717;
      --panel: #2f2f2f;
      --panel-hover: #3a3a3a;
      --border: #444;
      --text: #ececec;
      --muted: #a0a0a0;
      --accent: #10a37f;
      --danger: #ef4444;
      --user: #2f2f2f;
      --assistant: #212121;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    button,
    textarea {
      font: inherit;
    }

    /* =========================
       APP
       ========================= */

    .app {
      display: flex;
      width: 100%;
      height: 100vh;
    }

    /* =========================
       SIDEBAR
       ========================= */

    .sidebar {
      width: 260px;
      min-width: 260px;
      height: 100%;
      background: var(--sidebar);
      border-right: 1px solid #303030;
      display: flex;
      flex-direction: column;
      padding: 12px;
    }

    .new-chat {
      width: 100%;
      height: 46px;
      border: 1px solid #555;
      border-radius: 8px;
      background: transparent;
      color: var(--text);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 14px;
      font-size: 14px;
    }

    .new-chat:hover {
      background: #252525;
    }

    .brand {
      padding: 18px 10px 14px;
    }

    .brand-title {
      font-size: 16px;
      font-weight: 700;
    }

    .brand-id {
      margin-top: 4px;
      font-size: 11px;
      color: var(--muted);
    }

    .history-title {
      padding: 16px 10px 8px;
      color: #888;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .history {
      flex: 1;
      overflow-y: auto;
    }

    .history-item {
      width: 100%;
      border: 0;
      background: transparent;
      color: #d0d0d0;
      text-align: left;
      padding: 10px;
      border-radius: 7px;
      cursor: pointer;
      font-size: 13px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .history-item:hover {
      background: #252525;
    }

    .sidebar-footer {
      border-top: 1px solid #303030;
      padding-top: 12px;
      font-size: 11px;
      color: #777;
    }

    /* =========================
       MAIN
       ========================= */

    .main {
      flex: 1;
      min-width: 0;
      height: 100%;
      display: flex;
      flex-direction: column;
      background: var(--bg);
    }

    .topbar {
      height: 58px;
      min-height: 58px;
      border-bottom: 1px solid #303030;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
    }

    .agent-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 600;
    }

    .online-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 8px rgba(16,163,127,.5);
    }

    .offline-dot {
      background: var(--danger);
      box-shadow: none;
    }

    .model {
      color: var(--muted);
      font-size: 11px;
    }

    /* =========================
       CHAT
       ========================= */

    .chat {
      flex: 1;
      overflow-y: auto;
      scroll-behavior: smooth;
    }

    .welcome {
      max-width: 760px;
      margin: 0 auto;
      padding: 100px 24px 160px;
      text-align: center;
    }

    .welcome-icon {
      width: 54px;
      height: 54px;
      margin: 0 auto 20px;
      border-radius: 16px;
      background: var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 25px;
      font-weight: 800;
    }

    .welcome h1 {
      margin: 0 0 12px;
      font-size: 28px;
    }

    .welcome p {
      margin: 0;
      color: var(--muted);
      line-height: 1.6;
      font-size: 14px;
    }

    .examples {
      margin-top: 35px;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .example {
      border: 1px solid var(--border);
      background: #252525;
      color: #ddd;
      padding: 14px;
      border-radius: 10px;
      text-align: left;
      cursor: pointer;
      font-size: 13px;
    }

    .example:hover {
      background: #303030;
    }

    .message {
      width: 100%;
      border-bottom: 1px solid rgba(255,255,255,.03);
    }

    .message-inner {
      max-width: 820px;
      margin: 0 auto;
      padding: 22px 24px;
      display: flex;
      gap: 16px;
    }

    .avatar {
      width: 32px;
      height: 32px;
      min-width: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
    }

    .avatar.user {
      background: #555;
    }

    .avatar.ai {
      background: var(--accent);
    }

    .message-content {
      min-width: 0;
      flex: 1;
      line-height: 1.65;
      font-size: 14px;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .message-actions {
      margin-top: 10px;
      display: flex;
      gap: 6px;
    }

    .message-action {
      border: 0;
      background: transparent;
      color: #777;
      cursor: pointer;
      padding: 4px 7px;
      border-radius: 5px;
      font-size: 11px;
    }

    .message-action:hover {
      background: #333;
      color: #ddd;
    }

    /* =========================
       INPUT
       ========================= */

    .composer-area {
      width: 100%;
      padding: 12px 20px 18px;
      background: linear-gradient(
        to bottom,
        transparent,
        var(--bg) 20%
      );
    }

    .composer {
      max-width: 820px;
      margin: 0 auto;
      background: #2f2f2f;
      border: 1px solid #555;
      border-radius: 16px;
      padding: 10px 12px 10px 16px;
      display: flex;
      align-items: flex-end;
      gap: 10px;
      box-shadow: 0 5px 25px rgba(0,0,0,.25);
    }

    .composer textarea {
      flex: 1;
      min-width: 0;
      max-height: 180px;
      min-height: 28px;
      resize: none;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--text);
      line-height: 1.5;
      padding: 5px 0;
    }

    .composer textarea::placeholder {
      color: #888;
    }

    .send {
      width: 36px;
      height: 36px;
      min-width: 36px;
      border: 0;
      border-radius: 9px;
      background: #676767;
      color: white;
      cursor: pointer;
      font-size: 17px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .send.active {
      background: white;
      color: #111;
    }

    .send:disabled {
      opacity: .5;
      cursor: default;
    }

    .hint {
      max-width: 820px;
      margin: 7px auto 0;
      text-align: center;
      font-size: 10px;
      color: #777;
    }

    /* =========================
       LOADING
       ========================= */

    .typing {
      display: flex;
      gap: 5px;
      align-items: center;
      height: 24px;
    }

    .typing span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #999;
      animation: typing 1.2s infinite;
    }

    .typing span:nth-child(2) {
      animation-delay: .15s;
    }

    .typing span:nth-child(3) {
      animation-delay: .3s;
    }

    @keyframes typing {
      0%, 60%, 100% {
        opacity: .3;
        transform: translateY(0);
      }

      30% {
        opacity: 1;
        transform: translateY(-3px);
      }
    }

    /* =========================
       MOBILE
       ========================= */

    .mobile-menu {
      display: none;
    }

    @media (max-width: 700px) {
      .sidebar {
        position: fixed;
        z-index: 20;
        left: -270px;
        top: 0;
        transition: left .2s ease;
        box-shadow: 10px 0 30px rgba(0,0,0,.4);
      }

      .sidebar.open {
        left: 0;
      }

      .mobile-menu {
        display: block;
        border: 0;
        background: transparent;
        color: var(--text);
        font-size: 20px;
        cursor: pointer;
      }

      .topbar {
        padding: 0 12px;
      }

      .message-inner {
        padding: 18px 14px;
      }

      .composer-area {
        padding: 8px 10px 12px;
      }

      .welcome {
        padding: 70px 20px 130px;
      }

      .examples {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

<div class="app">

  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">

    <button class="new-chat" id="newChat">
      <span>＋</span>
      <span>New chat</span>
    </button>

    <div class="brand">
      <div class="brand-title">{{AGENT_NAME}}</div>
      <div class="brand-id">{{AGENT_ID}}</div>
    </div>

    <div class="history-title">Recent chats</div>

    <div class="history" id="history"></div>

    <div class="sidebar-footer">
      100 → 1 AI Agent
    </div>

  </aside>

  <!-- MAIN -->
  <main class="main">

    <header class="topbar">

      <div class="agent-title">

        <button class="mobile-menu" id="mobileMenu">
          ☰
        </button>

        <span class="online-dot" id="statusDot"></span>

        <span id="agentName">
          {{AGENT_NAME}}
        </span>

      </div>

      <div class="model" id="modelName">
        Connecting...
      </div>

    </header>

    <!-- CHAT -->
    <section class="chat" id="chat">

      <div class="welcome" id="welcome">

        <div class="welcome-icon">
          AI
        </div>

        <h1>
          How can I help you?
        </h1>

        <p>
          I'm {{AGENT_NAME}}.
          Tell me what you would like me to do.
        </p>

        <div class="examples">

          <button class="example">
            Write a professional email asking for an internship.
          </button>

          <button class="example">
            Improve my writing and make it more professional.
          </button>

          <button class="example">
            Write a short LinkedIn post about my project.
          </button>

          <button class="example">
            Summarize this text in simple language.
          </button>

        </div>

      </div>

    </section>

    <!-- COMPOSER -->
    <div class="composer-area">

      <div class="composer">

        <textarea
          id="input"
          rows="1"
          placeholder="Message {{AGENT_NAME}}..."
          autocomplete="off"
        ></textarea>

        <button
          class="send"
          id="send"
          disabled
          title="Send"
        >
          ↑
        </button>

      </div>

      <div class="hint">
        Enter to send · Shift + Enter for a new line
      </div>

    </div>

  </main>

</div>

<script>
  const API_BASE = "";

  const chat = document.getElementById("chat");
  const input = document.getElementById("input");
  const send = document.getElementById("send");
  const welcome = document.getElementById("welcome");
  const history = document.getElementById("history");
  const statusDot = document.getElementById("statusDot");
  const agentName = document.getElementById("agentName");
  const modelName = document.getElementById("modelName");

  const conversations = [];
  let currentConversation = [];
  let isProcessing = false;

  /* =========================
     AGENT INFO
     ========================= */

  async function loadAgentInfo() {
    try {
      const response = await fetch(API_BASE + "/api/info");
      const data = await response.json();

      agentName.textContent = data.agent_name || "{{AGENT_NAME}}";
      modelName.textContent = data.model || "AI";

      document.title = data.agent_name || "{{AGENT_NAME}}";

    } catch {
      modelName.textContent = "Offline";
      statusDot.classList.add("offline-dot");
    }
  }

  /* =========================
     HEALTH
     ========================= */

  async function checkHealth() {
    try {
      const response = await fetch(API_BASE + "/api/health");
      const data = await response.json();

      if (data.status === "ok") {
        statusDot.classList.remove("offline-dot");
        modelName.textContent = data.model || "Online";
      } else {
        statusDot.classList.add("offline-dot");
        modelName.textContent = "Offline";
      }

    } catch {
      statusDot.classList.add("offline-dot");
      modelName.textContent = "Offline";
    }
  }

  /* =========================
     MESSAGE HELPERS
     ========================= */

  function addMessage(role, text) {

    welcome.style.display = "none";

    const wrapper = document.createElement("div");
    wrapper.className = "message";

    const inner = document.createElement("div");
    inner.className = "message-inner";

    const avatar = document.createElement("div");
    avatar.className = "avatar " + (role === "user" ? "user" : "ai");
    avatar.textContent = role === "user" ? "U" : "AI";

    const contentWrapper = document.createElement("div");
    contentWrapper.style.flex = "1";

    const content = document.createElement("div");
    content.className = "message-content";
    content.textContent = text;

    contentWrapper.appendChild(content);

    if (role === "assistant") {

      const actions = document.createElement("div");
      actions.className = "message-actions";

      const copy = document.createElement("button");
      copy.className = "message-action";
      copy.textContent = "Copy";

      copy.onclick = async () => {
        try {
          await navigator.clipboard.writeText(text);
          copy.textContent = "Copied";
          setTimeout(() => {
            copy.textContent = "Copy";
          }, 1200);
        } catch {
          copy.textContent = "Copy failed";
        }
      };

      actions.appendChild(copy);
      contentWrapper.appendChild(actions);
    }

    inner.appendChild(avatar);
    inner.appendChild(contentWrapper);
    wrapper.appendChild(inner);

    chat.appendChild(wrapper);

    chat.scrollTop = chat.scrollHeight;

    return content;
  }

  function addTyping() {

    welcome.style.display = "none";

    const wrapper = document.createElement("div");
    wrapper.className = "message";
    wrapper.id = "typingMessage";

    const inner = document.createElement("div");
    inner.className = "message-inner";

    const avatar = document.createElement("div");
    avatar.className = "avatar ai";
    avatar.textContent = "AI";

    const content = document.createElement("div");
    content.className = "message-content";

    content.innerHTML = `
      <div class="typing">
        <span></span>
        <span></span>
        <span></span>
      </div>
    `;

    inner.appendChild(avatar);
    inner.appendChild(content);
    wrapper.appendChild(inner);
    chat.appendChild(wrapper);

    chat.scrollTop = chat.scrollHeight;
  }

  function removeTyping() {
    document.getElementById("typingMessage")?.remove();
  }

  /* =========================
     SEND
     ========================= */

  async function sendMessage() {

    if (isProcessing) return;

    const task = input.value.trim();

    if (!task) return;

    isProcessing = true;
    send.disabled = true;

    addMessage("user", task);

    currentConversation.push({
      role: "user",
      content: task
    });

    input.value = "";
    resizeInput();

    addTyping();

    try {

      const response = await fetch(
        API_BASE + "/api/agent",
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json"
          },

          body: JSON.stringify({
            task,

            context: {
              conversation: currentConversation
            },

            parameters: {
              source: "chat-ui"
            },

            output_format: "structured"
          })
        }
      );

      const data = await response.json();

      removeTyping();

      if (!response.ok || data.status === "error") {
        throw new Error(
          data.error || "Agent request failed"
        );
      }

      let answer = data.result;

      if (typeof answer !== "string") {
        answer = JSON.stringify(
          answer,
          null,
          2
        );
      }

      addMessage("assistant", answer);

      currentConversation.push({
        role: "assistant",
        content: answer
      });

      saveHistory(task);

    } catch (error) {

      removeTyping();

      addMessage(
        "assistant",
        "Sorry, something went wrong.\n\n" +
        error.message
      );

    } finally {

      isProcessing = false;

      updateSendButton();

      input.focus();
    }
  }

  /* =========================
     HISTORY
     ========================= */

  function saveHistory(firstMessage) {

    const item = document.createElement("button");

    item.className = "history-item";

    item.textContent =
      firstMessage.length > 38
        ? firstMessage.slice(0, 38) + "..."
        : firstMessage;

    history.prepend(item);
  }

  /* =========================
     NEW CHAT
     ========================= */

  function newChat() {

    currentConversation = [];

    chat.innerHTML = "";

    chat.appendChild(welcome);

    welcome.style.display = "block";

    input.value = "";

    resizeInput();

    input.focus();
  }

  document
    .getElementById("newChat")
    .addEventListener("click", newChat);

  /* =========================
     EXAMPLES
     ========================= */

  document
    .querySelectorAll(".example")
    .forEach(button => {

      button.addEventListener("click", () => {

        input.value = button.textContent.trim();

        resizeInput();

        updateSendButton();

        input.focus();

      });

    });

  /* =========================
     INPUT
     ========================= */

  function resizeInput() {

    input.style.height = "auto";

    input.style.height =
      Math.min(input.scrollHeight, 180) + "px";

  }

  function updateSendButton() {

    const hasText =
      input.value.trim().length > 0;

    send.disabled =
      !hasText || isProcessing;

    send.classList.toggle(
      "active",
      hasText && !isProcessing
    );
  }

  input.addEventListener(
    "input",
    () => {
      resizeInput();
      updateSendButton();
    }
  );

  input.addEventListener(
    "keydown",
    event => {

      if (
        event.key === "Enter" &&
        !event.shiftKey
      ) {

        event.preventDefault();

        sendMessage();
      }

    }
  );

  send.addEventListener(
    "click",
    sendMessage
  );

  /* =========================
     MOBILE MENU
     ========================= */

  document
    .getElementById("mobileMenu")
    .addEventListener("click", () => {

      document
        .getElementById("sidebar")
        .classList.toggle("open");

    });

  /* =========================
     START
     ========================= */

  loadAgentInfo();
  checkHealth();

  setInterval(
    checkHealth,
    30000
  );

  input.focus();
</script>

</body>
</html>
