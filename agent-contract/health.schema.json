{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://100-to-1.dev/schemas/agent-health.json",
  "title": "100-to-1 Agent Health",
  "type": "object",
  "required": [
    "status",
    "agent_id"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "offline"
      ]
    },
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
