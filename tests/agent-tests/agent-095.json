  "valid_test": {
    "description": "Domain-specific task exercising AI Business Operations Agent capabilities",
    "payload": {
      "task": "Map and optimize end-to-end enterprise business operations quote-to-cash workflow, removing bottlenecks and manual steps.",
      "context": {
        "cycle_time_reduction": "30%"
      },
      "parameters": {
