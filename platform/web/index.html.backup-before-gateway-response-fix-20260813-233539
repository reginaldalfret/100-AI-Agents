    const panel =
      createPanel();

    panel.innerHTML = `

      <div class="agent-info-header">

        <div>

          <div class="agent-info-title">
            Capabilities
          </div>

          <div class="agent-info-subtitle">
            What ${agent.name} can help you accomplish
          </div>

        </div>

        <button
          class="agent-info-close"
          onclick="window.agentTabs.close()">
          ×
        </button>

      </div>


      <div class="agent-info-grid">

        <div class="agent-info-card">

          <div class="agent-info-card-label">
            Specialty
          </div>

          <div class="agent-info-card-value">
            ${agent.category}
          </div>

        </div>


        <div class="agent-info-card">

          <div class="agent-info-card-label">
            Agent
          </div>

          <div class="agent-info-card-value">
            ${agent.id}
          </div>

        </div>


        <div class="agent-info-card">

          <div class="agent-info-card-label">
            Availability
          </div>

          <div class="agent-info-card-value">
            <span style="color:#00ff9d">
              ● Online
            </span>
          </div>

        </div>

      </div>


      <div class="agent-info-section">

        <h3>
          Core capabilities
        </h3>

        <ul class="agent-capability-list">

          ${capabilities.map(
            capability => `
              <li class="agent-capability-item">
                ${capability}
              </li>
            `
          ).join("")}

        </ul>

      </div>

    `;

    panel.classList.add("visible");

  }


  /* =======================================================
     EXAMPLES
     ======================================================= */

  function renderExamples() {

    updateAgent();

    const agent =
      currentAgent || getAgentFromPage();

    const examples =
      exampleMap[agent.id] ||
      genericExamples;

    const panel =
      createPanel();

    panel.innerHTML = `

      <div class="agent-info-header">

        <div>

          <div class="agent-info-title">
            Examples
          </div>

          <div class="agent-info-subtitle">
            Try one of these tasks with ${agent.name}
          </div>

        </div>

        <button
          class="agent-info-close"
          onclick="window.agentTabs.close()">
          ×
        </button>

      </div>


      <div class="agent-example-list">

        ${examples.map(
          (example, index) => `

            <button
              class="agent-example"
              data-example-index="${index}">

              <div class="agent-example-title">
                ${example[0]}
              </div>

              <div class="agent-example-text">
                ${example[1]}
              </div>

              <div class="agent-example-use">
                Use this example →
              </div>

            </button>

          `
        ).join("")}

      </div>

    `;

    panel.classList.add("visible");


    panel
      .querySelectorAll(".agent-example")
      .forEach(function (button) {

        button.addEventListener(
          "click",
          function () {

            const index =
              Number(
                button.dataset.exampleIndex
              );

            const example =
              examples[index];

            useExample(example[1]);

          }
        );

      });

  }


  /* =======================================================
     USE EXAMPLE
     ======================================================= */

  function useExample(text) {

    const panel =
      document.getElementById(
        "agentInfoPanel"
      );

    if (panel) {
      panel.classList.remove("visible");
    }

    currentTab = "chat";


    const inputs =
      document.querySelectorAll(
        "textarea, input"
      );

    let input = null;

    for (const candidate of inputs) {

      const placeholder =
        (
          candidate.getAttribute(
            "placeholder"
          ) || ""
        ).toLowerCase();

      if (
        placeholder.includes("message") ||
        placeholder.includes("ask")
      ) {
        input = candidate;
        break;
      }

    }

    if (!input) {
      console.warn(
        "Chat input not found"
      );

      return;

    }


    input.focus();

    input.value = text;

    input.dispatchEvent(
      new Event(
        "input",
        {
          bubbles: true
        }
      )
    );

    input.dispatchEvent(
      new Event(
        "change",
        {
          bubbles: true
        }
      )
    );

  }


  /* =======================================================
     CLOSE PANEL
     ======================================================= */

  function closePanel() {

    const panel =
      document.getElementById(
        "agentInfoPanel"
      );

    if (panel) {
      panel.classList.remove("visible");
    }

    currentTab = "chat";

  }


  /* =======================================================
     TAB DETECTION
     ======================================================= */

  function handleTabClick(event) {

    const target =
      event.target.closest(
        "button, a"
      );

    if (!target) {
      return;
    }

    const label =
      (target.textContent || "")
        .trim()
        .toLowerCase();

    if (label === "about") {

      event.preventDefault();
      event.stopPropagation();

      currentTab = "about";

      renderAbout();

      return;
    }


    if (
      label === "capabilities" ||
      label.includes("capabilities")
    ) {

      event.preventDefault();
      event.stopPropagation();

      currentTab = "capabilities";

      renderCapabilities();

      return;
    }


    if (
      label === "examples" ||
      label === "example"
    ) {

      event.preventDefault();
      event.stopPropagation();

      currentTab = "examples";

      renderExamples();

      return;
    }


    if (label === "chat") {

      closePanel();

    }

  }


  /* =======================================================
     GLOBAL API
     ======================================================= */

  window.agentTabs = {

    about: renderAbout,

    capabilities:
      renderCapabilities,

    examples:
      renderExamples,

    close:
      closePanel,

    useExample:
      useExample

  };


  /* =======================================================
     EVENTS
     ======================================================= */

  document.addEventListener(
    "click",
    handleTabClick,
    true
  );


  /* Detect agent changes */

  setInterval(
    updateAgent,
    1000
  );


  updateAgent();

})();

</script>

</head>

<body>

