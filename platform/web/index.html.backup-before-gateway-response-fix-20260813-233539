<script>
"use strict";

/* =========================================================
   CONFIG
   ========================================================= */

const API = window.location.origin;

let agents = [];
let selectedAgent = null;
let activeCategory = "all";
let loading = false;

/* =========================================================
   DOM
   ========================================================= */

const agentList = document.getElementById("agentList");
const categories = document.getElementById("categories");
const search = document.getElementById("agentSearch");
const input = document.getElementById("input");
const send = document.getElementById("send");
const messages = document.getElementById("messages");

const headerTitle = document.getElementById("headerTitle");
const headerMeta = document.getElementById("headerMeta");
const headerAvatar = document.getElementById("headerAvatar");

const welcomeTitle = document.getElementById("welcomeTitle");
const welcomeText = document.getElementById("welcomeText");

const agentCount = document.getElementById("agentCount");
const allCount = document.getElementById("allCount");
const onlineNumber = document.getElementById("onlineNumber");
const headerCount = document.getElementById("headerCount");

const sidebar = document.getElementById("sidebar");

/* =========================================================
   LOAD AGENTS
   ========================================================= */

async function loadAgents() {

  try {

    const response = await fetch(
      API + "/api/agents",
      {
        cache: "no-store"
      }
    );

    if (!response.ok) {
      throw new Error(
        "Failed to load agents"
      );
    }

    const data = await response.json();

    agents =
      Array.isArray(data.agents)
        ? data.agents
        : [];

    renderCategories();
    renderAgents();

    const saved =
      localStorage.getItem(
        "100ai-selected-agent"
      );

    const found =
      agents.find(
        a => a.agent_id === saved
      );

    if (found) {
      selectAgent(found.agent_id);
    } else if (agents.length) {
      selectAgent(agents[0].agent_id);
    }

  } catch (error) {

    console.error(error);

    agentList.innerHTML = `
      <div class="empty">
        Unable to load agents.
      </div>
    `;

  }

}

/* =========================================================
   CATEGORIES
   ========================================================= */

function renderCategories() {

  const map = new Map();

  agents.forEach(agent => {

    const category =
      agent.category ||
      "general";

    map.set(
      category,
      (map.get(category) || 0) + 1
    );

  });

  categories.innerHTML = `
    <div
      class="category ${activeCategory === "all" ? "active" : ""}"
      data-category="all"
    >
      <span>◈</span>
      <span>All Agents</span>
      <span class="category-count">
        ${agents.length}
      </span>
    </div>
  `;

  [...map.entries()]
    .sort((a,b) => a[0].localeCompare(b[0]))
    .forEach(
      ([category,count]) => {

        const el =
          document.createElement("div");

        el.className =
          "category " +
          (
            activeCategory === category
              ? "active"
              : ""
          );

        el.dataset.category =
          category;

        el.innerHTML = `
          <span>◈</span>
          <span>${escapeHtml(category)}</span>
          <span class="category-count">
            ${count}
          </span>
        `;

        categories.appendChild(el);

      }
    );

}

/* =========================================================
   AGENT LIST
   ========================================================= */

function renderAgents() {

  const query =
    search.value
      .trim()
      .toLowerCase();

  const filtered =
    agents.filter(agent => {

      const category =
        agent.category ||
        "general";

      const categoryMatch =
        activeCategory === "all" ||
        category === activeCategory;

      const searchable =
        [
          agent.name,
          agent.agent_id,
          agent.slug,
          agent.category
        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();

      const searchMatch =
        !query ||
        searchable.includes(query);

      return categoryMatch &&
             searchMatch;

    });

  agentList.innerHTML = "";

  agentCount.textContent =
    `(${filtered.length})`;

  if (!filtered.length) {

    document.getElementById(
      "agentEmpty"
    ).style.display = "block";

    return;

  }

  document.getElementById(
    "agentEmpty"
  ).style.display = "none";

  filtered.forEach(agent => {

    const item =
      document.createElement("div");

    item.className =
      "agent " +
      (
        selectedAgent &&
        selectedAgent.agent_id === agent.agent_id
          ? "active"
          : ""
      );

    item.dataset.id =
      agent.agent_id;

    item.innerHTML = `
      <span class="status-dot"></span>

      <div class="agent-info">

        <div class="agent-name">
          ${escapeHtml(
            agent.name ||
            agent.agent_id
          )}
        </div>

        <div class="agent-meta">
          ${escapeHtml(
            agent.agent_id
          )}
          ·
          ${escapeHtml(
            agent.category ||
            "general"
          )}
        </div>

      </div>
    `;

    item.addEventListener(
      "click",
      () => {

        selectAgent(
          agent.agent_id
        );

        if (
          window.innerWidth <= 900
        ) {
          sidebar.classList.remove(
            "open"
          );
        }

      }
    );

    agentList.appendChild(item);

  });

}

/* =========================================================
   SELECT AGENT
   ========================================================= */

function selectAgent(id) {

  const agent =
    agents.find(
      a => a.agent_id === id
    );

  if (!agent) return;

  selectedAgent = agent;

  localStorage.setItem(
    "100ai-selected-agent",
    id
  );

  headerTitle.textContent =
    agent.name || id;

  headerMeta.textContent =
    `${agent.agent_id} · ${agent.category || "general"}`;

  headerAvatar.textContent = "✦";

  welcomeTitle.textContent =
    agent.name || "AI Agent";

  welcomeText.textContent =
    `Ask anything related to ${agent.name || "this agent"}'s specialty.`;

  input.placeholder =
    `Message ${agent.name || "AI Agent"}...`;

  renderAgents();

  loadConversation();

}

/* =========================================================
   CHAT STORAGE
   ========================================================= */

function storageKey() {

  return (
    "100ai-chat-" +
    (
      selectedAgent
        ? selectedAgent.agent_id
        : "none"
    )
  );

}

function getHistory() {

  try {

    return JSON.parse(
      localStorage.getItem(
        storageKey()
      ) || "[]"
    );

  } catch {

    return [];

  }

}

function saveHistory(history) {

  localStorage.setItem(
    storageKey(),
    JSON.stringify(history)
  );

}

/* =========================================================
   LOAD CONVERSATION
   ========================================================= */

function loadConversation() {

  const history =
    getHistory();

  messages.innerHTML = "";

  if (!history.length) {

    messages.innerHTML = `
      <div class="welcome">

        <div class="welcome-inner">

          <div class="welcome-icon">
            ✦
          </div>

          <h1>
            ${escapeHtml(
              selectedAgent?.name ||
              "100 AI Agents"
            )}
          </h1>

          <p>
            Ask anything related to this
            agent's specialty.
          </p>

        </div>

      </div>
    `;

    return;

  }

  history.forEach(message => {

    addMessage(
      message.role,
      message.content,
      false
    );

  });

  scrollBottom();

}

/* =========================================================
   ADD MESSAGE
   ========================================================= */

function addMessage(
  role,
  content,
  save = true
) {

  const welcome =
    messages.querySelector(
      ".welcome"
    );

  if (welcome) {
    welcome.remove();
  }

  const wrapper =
    document.createElement("div");

  wrapper.className =
    "message " +
    (
      role === "user"
        ? "user"
        : "ai"
    );

  const avatar =
    role === "user"
      ? "You"
      : "AI";

  const name =
    role === "user"
      ? "You"
      : (
          selectedAgent?.name ||
          "AI Agent"
        );

  wrapper.innerHTML = `
    ${
      role === "user"
        ? ""
        : `
          <div class="message-avatar">
            ${avatar}
          </div>
        `
    }

    <div>

      <div class="bubble">

        <div class="message-name">
          ${escapeHtml(name)}
        </div>

        <div class="message-content">
          ${formatText(content)}
        </div>

      </div>

      <div class="message-time">
        ${new Date().toLocaleTimeString(
          [],
          {
            hour: "2-digit",
            minute: "2-digit"
          }
        )}
      </div>

      ${
        role === "assistant" ||
        role === "ai"
          ? `
            <div class="message-actions">
              <button
                class="message-action copy-btn"
              >
                Copy
              </button>
            </div>
          `
          : ""
      }

    </div>

    ${
      role === "user"
        ? `
          <div class="message-avatar">
            ${avatar}
          </div>
        `
        : ""
    }
  `;

  messages.appendChild(wrapper);

  const copy =
    wrapper.querySelector(
      ".copy-btn"
    );

  if (copy) {

    copy.addEventListener(
      "click",
      async () => {

        await navigator.clipboard.writeText(
          content
        );

        copy.textContent =
          "Copied";

        setTimeout(
          () => {
            copy.textContent =
              "Copy";
          },
          1200
        );

      }
    );

  }

  if (save) {

    const history =
      getHistory();

    history.push({
      role,
      content
    });

    saveHistory(history);

  }

}

/* =========================================================
   SEND MESSAGE
   ========================================================= */

async function sendMessage() {

  if (loading) return;

  const task =
    input.value.trim();

  if (!task) return;

  if (!selectedAgent) {

    alert(
      "Please select an agent first."
    );

    return;

  }

  loading = true;

  send.disabled = true;

  input.value = "";

  resizeInput();

  addMessage(
    "user",
    task
  );

  const loadingMessage =
    document.createElement("div");

  loadingMessage.className =
    "message ai";

  loadingMessage.innerHTML = `
    <div class="message-avatar">
      AI
    </div>

    <div>

      <div class="bubble">

        <div class="message-name">
          ${escapeHtml(
            selectedAgent.name
          )}
        </div>

        <div class="typing">
          <span></span>
          <span></span>
          <span></span>
        </div>

      </div>

    </div>
  `;

  messages.appendChild(
    loadingMessage
  );

  scrollBottom();

  try {

    const response =
      await fetch(
        API + "/api/chat",
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body: JSON.stringify({
            agent_id:
              selectedAgent.agent_id,

            task,

            context: {},

            parameters: {},

            output_format: "text"
          })
        }
      );

    const data =
      await response.json();

    loadingMessage.remove();

    /*
     * =========================================================
     * SAFE HUMAN-READABLE RESPONSE HANDLER
     * =========================================================
     *
     * The API intentionally returns structured JSON.
     * The chat UI must NEVER expose that raw JSON.
     *
     * Rejected:
     *   show only error.message
     *
     * Successful:
     *   show only result/result.response/result.message
     *
     * Never render:
     *   metadata
     *   agent_id
     *   detected_intents
     *   capabilities
     *   error objects
     *   raw JSON.stringify(data)
     */

    let result = "";

    if (data && data.status === "rejected") {

      if (
        data.error &&
        typeof data.error === "object" &&
        typeof data.error.message === "string"
      ) {

        result = data.error.message;

      } else if (
        typeof data.error === "string"
      ) {

        result = data.error;

      } else {

        result =
          "I'm sorry, but this request is outside this agent's specialization.";

      }

    } else if (
      data &&
      data.status === "success"
    ) {

      if (
        typeof data.result === "string"
      ) {

        result = data.result;

      } else if (
        data.result &&
        typeof data.result === "object"
      ) {

        if (
          typeof data.result.result === "string"
        ) {

          result = data.result.result;

        } else if (
          typeof data.result.response === "string"
        ) {

          result = data.result.response;

        } else if (
          typeof data.result.message === "string"
        ) {

          result = data.result.message;

        } else if (
          typeof data.result.text === "string"
        ) {

          result = data.result.text;

        }

      }

    }

    /*
     * Final fallback for server errors.
     * Extract only a human-readable message.
     */
    if (!result) {

      if (
        data &&
        data.error &&
        typeof data.error === "object" &&
        typeof data.error.message === "string"
      ) {

        result = data.error.message;

      } else if (
        data &&
        typeof data.error === "string"
      ) {

        result = data.error;

      } else {

        result =
          "The agent could not complete the request. Please try again.";

      }

    }

    addMessage(
      "assistant",
      result
    );

  } catch (error) {

    loadingMessage.remove();

    addMessage(
      "assistant",
      "Unable to connect to the 100 AI Agents gateway.\n\n" +
      error.message
    );

  } finally {

    loading = false;

    send.disabled = false;

    input.focus();

    scrollBottom();

  }

}

/* =========================================================
   NEW CHAT
   ========================================================= */

function newChat() {

  if (!selectedAgent) return;

  localStorage.removeItem(
    storageKey()
  );

  loadConversation();

  input.focus();

}

/* =========================================================
   CLEAR
   ========================================================= */

document
  .getElementById("clearChatTop")
  .addEventListener(
    "click",
    newChat
  );

document
  .getElementById("newChat")
  .addEventListener(
    "click",
    newChat
  );

/* =========================================================
   CATEGORY CLICK
   ========================================================= */

categories.addEventListener(
  "click",
  event => {

    const category =
      event.target.closest(
        ".category"
      );

    if (!category) return;

    activeCategory =
      category.dataset.category;

    renderCategories();
    renderAgents();

  }
);

/* =========================================================
   SEARCH
   ========================================================= */

search.addEventListener(
  "input",
  renderAgents
);

/* =========================================================
   SEND BUTTON
   ========================================================= */

send.addEventListener(
  "click",
  sendMessage
);

/* =========================================================
   KEYBOARD
   ========================================================= */

input.addEventListener(
  "keydown",
  event => {

    if (
      event.key === "Enter" &&
      !event.shiftKey
    ) {

      event.preventDefault();

      sendMessage();

    }

  }
);

/* =========================================================
   AUTO RESIZE
   ========================================================= */

input.addEventListener(
  "input",
  resizeInput
);

function resizeInput() {

  input.style.height =
    "auto";

  input.style.height =
    Math.min(
      input.scrollHeight,
      160
    ) + "px";

}

/* =========================================================
   MOBILE
   ========================================================= */

document
  .getElementById("mobileMenu")
  .addEventListener(
    "click",
    () => {

      sidebar.classList.toggle(
        "open"
      );

    }
  );

/* =========================================================
   SCROLL
   ========================================================= */

function scrollBottom() {

  requestAnimationFrame(
    () => {

      messages.scrollTop =
        messages.scrollHeight;

    }
  );

}

/* =========================================================
   FORMAT TEXT
   ========================================================= */

function formatText(text) {

  let html =
    escapeHtml(
      String(text ?? "")
    );

  html =
    html.replace(
      /```([\s\S]*?)```/g,
      "<pre style=\"" +
      "overflow:auto;" +
      "padding:12px;" +
      "border-radius:10px;" +
      "background:rgba(0,0,0,.35);" +
      "border:1px solid rgba(255,255,255,.08);" +
      "\">$1</pre>"
    );

  html =
    html.replace(
      /\*\*(.*?)\*\*/g,
      "<strong>$1</strong>"
    );

  html =
    html.replace(
      /^### (.*)$/gm,
      "<strong style=\"color:#00eaff\">$1</strong>"
    );

  html =
    html.replace(
      /\n/g,
      "<br>"
    );

  return html;

}

/* =========================================================
   ESCAPE
   ========================================================= */

function escapeHtml(value) {

  return String(value ?? "")
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&#039;"
    );

}

/* =========================================================
   INIT
   ========================================================= */

loadAgents();

</script>

