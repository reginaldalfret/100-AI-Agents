<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#05050c">
<title>100 AI Agents</title>

<style>
* {
  box-sizing: border-box;
}

:root {
  --bg: #03040a;
  --panel: rgba(10, 12, 25, .72);
  --panel-strong: rgba(12, 15, 32, .9);
  --border: rgba(255,255,255,.10);
  --text: #f5f7ff;
  --muted: #8c93aa;
  --cyan: #00eaff;
  --blue: #287bff;
  --purple: #8b3dff;
  --pink: #ff22d7;
  --green: #00f5a0;
  --radius: 20px;
}

html,
body {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

body {
  position: relative;
}

/* =========================================================
   RGB LIQUID BACKGROUND
   ========================================================= */

body::before,
body::after {
  content: "";
  position: fixed;
  inset: -25%;
  pointer-events: none;
  z-index: -3;
}

body::before {
  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(0,234,255,.18),
      transparent 25%
    ),
    radial-gradient(
      circle at 85% 15%,
      rgba(255,34,215,.16),
      transparent 25%
    ),
    radial-gradient(
      circle at 75% 80%,
      rgba(95,40,255,.20),
      transparent 30%
    ),
    radial-gradient(
      circle at 20% 85%,
      rgba(0,120,255,.15),
      transparent 25%
    );
  filter: blur(70px);
  animation: ambientMove 18s ease-in-out infinite alternate;
}

body::after {
  background:
    linear-gradient(
      120deg,
      transparent 25%,
      rgba(0,234,255,.045),
      transparent 45%,
      rgba(255,0,221,.05),
      transparent 65%
    );
  filter: blur(35px);
  animation: rgbFlow 14s linear infinite;
}

@keyframes ambientMove {
  0% {
    transform: translate(-3%, -2%) scale(1);
  }

  50% {
    transform: translate(3%, 2%) scale(1.08);
  }

  100% {
    transform: translate(-1%, 4%) scale(1.03);
  }
}

@keyframes rgbFlow {
  from {
    transform: rotate(0deg) scale(1);
  }

  to {
    transform: rotate(360deg) scale(1.15);
  }
}

/* =========================================================
   APP
   ========================================================= */

.app {
  width: 100vw;
  height: 100vh;
  display: flex;
  padding: 10px;
  gap: 10px;
}

/* =========================================================
   GLASS
   ========================================================= */

.glass {
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.075),
      rgba(255,255,255,.025)
    );
  backdrop-filter: blur(28px) saturate(150%);
  -webkit-backdrop-filter: blur(28px) saturate(150%);
  border: 1px solid var(--border);
  box-shadow:
    0 25px 80px rgba(0,0,0,.45),
    inset 0 1px 0 rgba(255,255,255,.07);
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar {
  width: 315px;
  min-width: 315px;
  height: 100%;
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

.sidebar::before {
  content: "";
  position: absolute;
  top: -100px;
  left: -80px;
  width: 260px;
  height: 260px;
  background: radial-gradient(
    circle,
    rgba(0,234,255,.16),
    transparent 70%
  );
  filter: blur(30px);
  pointer-events: none;
}

.brand {
  padding: 22px 20px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo {
  width: 48px;
  height: 48px;
  border-radius: 15px;
  display: grid;
  place-items: center;
  font-size: 19px;
  font-weight: 900;
  color: white;

  background:
    linear-gradient(
      135deg,
      rgba(0,234,255,.18),
      rgba(139,61,255,.22),
      rgba(255,34,215,.18)
    );

  border: 1px solid rgba(0,234,255,.5);

  box-shadow:
    0 0 20px rgba(0,234,255,.25),
    0 0 45px rgba(139,61,255,.12);
}

.brand-title {
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -.4px;
}

.brand-subtitle {
  margin-top: 3px;
  font-size: 11px;
  color: var(--muted);
}

/* =========================================================
   NEW CHAT
   ========================================================= */

.new-chat {
  margin: 0 15px 12px;
  height: 48px;
  border-radius: 14px;
  border: 1px solid rgba(0,234,255,.28);

  color: white;
  font-size: 14px;
  font-weight: 700;

  cursor: pointer;

  background:
    linear-gradient(
      100deg,
      rgba(0,234,255,.12),
      rgba(45,90,255,.10),
      rgba(255,0,214,.12)
    );

  box-shadow:
    0 0 20px rgba(0,234,255,.07);

  transition: .25s ease;
}

.new-chat:hover {
  transform: translateY(-1px);

  border-color: rgba(255,34,215,.65);

  box-shadow:
    0 0 18px rgba(0,234,255,.18),
    0 0 35px rgba(255,34,215,.10);
}

/* =========================================================
   SEARCH
   ========================================================= */

.search-wrap {
  padding: 0 15px 14px;
}

.search {
  width: 100%;
  height: 42px;
  border-radius: 13px;

  border: 1px solid rgba(255,255,255,.09);

  background:
    rgba(0,0,0,.20);

  color: white;
  outline: none;

  padding: 0 13px 0 38px;
  font-size: 13px;

  transition: .2s;
}

.search:focus {
  border-color: rgba(0,234,255,.45);
  box-shadow:
    0 0 20px rgba(0,234,255,.08);
}

.search-icon {
  position: absolute;
  margin: 12px 0 0 13px;
  color: var(--muted);
  pointer-events: none;
}

/* =========================================================
   SIDEBAR CONTENT
   ========================================================= */

.sidebar-content {
  flex: 1;
  overflow-y: auto;
  padding: 0 9px 10px;
}

.sidebar-content::-webkit-scrollbar,
.messages::-webkit-scrollbar {
  width: 5px;
}

.sidebar-content::-webkit-scrollbar-thumb,
.messages::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,.12);
  border-radius: 20px;
}

.section-title {
  padding: 5px 11px 8px;
  color: #707891;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.3px;
  text-transform: uppercase;
}

/* =========================================================
   CATEGORIES
   ========================================================= */

.categories {
  display: flex;
  flex-direction: column;
  gap: 3px;
  margin-bottom: 12px;
}

.category {
  height: 37px;
  border-radius: 11px;

  padding: 0 10px;

  display: flex;
  align-items: center;
  gap: 9px;

  color: #aeb5ca;
  cursor: pointer;

  font-size: 12px;

  transition: .2s;
}

.category:hover {
  background: rgba(255,255,255,.05);
  color: white;
}

.category.active {
  color: white;

  background:
    linear-gradient(
      90deg,
      rgba(0,234,255,.15),
      rgba(139,61,255,.14),
      rgba(255,34,215,.12)
    );

  border: 1px solid rgba(0,234,255,.23);

  box-shadow:
    inset 0 0 20px rgba(0,234,255,.035),
    0 0 18px rgba(0,234,255,.05);
}

.category-count {
  margin-left: auto;
  color: #727a94;
}

/* =========================================================
   AGENT LIST
   ========================================================= */

.agent-list {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.agent {
  min-height: 49px;
  border-radius: 12px;

  padding: 7px 9px;

  display: flex;
  align-items: center;
  gap: 9px;

  cursor: pointer;

  border: 1px solid transparent;

  transition: .2s;
}

.agent:hover {
  background: rgba(255,255,255,.045);
}

.agent.active {
  background:
    linear-gradient(
      90deg,
      rgba(0,234,255,.13),
      rgba(76,64,255,.10),
      rgba(255,0,214,.12)
    );

  border-color: rgba(139,61,255,.38);

  box-shadow:
    inset 0 0 25px rgba(0,234,255,.025),
    0 0 20px rgba(139,61,255,.07);
}

.status-dot {
  width: 8px;
  height: 8px;
  min-width: 8px;
  border-radius: 50%;
  background: var(--green);

  box-shadow:
    0 0 7px var(--green),
    0 0 14px rgba(0,245,160,.45);

  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%,100% {
    opacity: .8;
    transform: scale(1);
  }

  50% {
    opacity: 1;
    transform: scale(1.18);
  }
}

.agent-info {
  min-width: 0;
  flex: 1;
}

.agent-name {
  color: #e8ebf6;
  font-size: 12px;
  line-height: 17px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.agent-meta {
  color: #737b94;
  font-size: 10px;
}

.agent-id {
  color: #666d83;
  font-size: 9px;
}

/* =========================================================
   SIDEBAR FOOTER
   ========================================================= */

.sidebar-footer {
  padding: 11px;
  border-top: 1px solid rgba(255,255,255,.06);
}

.online-card {
  min-height: 62px;
  padding: 10px 11px;

  border-radius: 14px;

  background:
    linear-gradient(
      120deg,
      rgba(0,245,160,.07),
      rgba(0,234,255,.035),
      rgba(139,61,255,.06)
    );

  border: 1px solid rgba(0,245,160,.13);

  display: flex;
  align-items: center;
  gap: 10px;
}

.online-number {
  font-size: 13px;
  font-weight: 800;
}

.online-label {
  color: #69718b;
  font-size: 10px;
  margin-top: 2px;
}

.wave {
  margin-left: auto;
  width: 60px;
  height: 25px;
  opacity: .8;
}

/* =========================================================
   MAIN
   ========================================================= */

.main {
  flex: 1;
  min-width: 0;
  height: 100%;
  border-radius: 24px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
}

.main::after {
  content: "";
  position: absolute;
  width: 500px;
  height: 500px;
  right: -260px;
  bottom: -280px;

  background:
    radial-gradient(
      circle,
      rgba(0,234,255,.10),
      rgba(139,61,255,.08),
      transparent 70%
    );

  filter: blur(40px);
  pointer-events: none;
}

/* =========================================================
   HEADER
   ========================================================= */

.header {
  height: 72px;
  min-height: 72px;

  display: flex;
  align-items: center;

  padding: 0 22px;

  border-bottom: 1px solid rgba(255,255,255,.07);
}

.mobile-menu {
  display: none;
}

.agent-avatar {
  width: 42px;
  height: 42px;

  border-radius: 14px;

  display: grid;
  place-items: center;

  font-size: 18px;

  color: var(--cyan);

  border: 1px solid rgba(0,234,255,.4);

  background:
    linear-gradient(
      135deg,
      rgba(0,234,255,.10),
      rgba(139,61,255,.13)
    );

  box-shadow:
    0 0 18px rgba(0,234,255,.10);
}

.header-info {
  margin-left: 12px;
  min-width: 0;
}

.header-title {
  font-size: 16px;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.header-meta {
  margin-top: 3px;
  font-size: 10px;
  color: var(--muted);
}

.header-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 9px;
}

.status-pill {
  height: 35px;
  padding: 0 13px;

  border-radius: 999px;

  display: flex;
  align-items: center;
  gap: 7px;

  font-size: 11px;
  color: #b6ffe7;

  border: 1px solid rgba(0,245,160,.18);

  background:
    rgba(0,245,160,.045);
}

.status-pill .status-dot {
  width: 6px;
  height: 6px;
  min-width: 6px;
}

.count-pill {
  height: 35px;
  padding: 0 13px;

  border-radius: 999px;

  color: #d8ccff;
  font-size: 11px;

  border: 1px solid rgba(139,61,255,.22);

  background:
    rgba(139,61,255,.055);
}

.icon-button {
  width: 36px;
  height: 36px;

  border-radius: 11px;

  border: 1px solid rgba(255,255,255,.09);

  background: rgba(255,255,255,.035);

  color: #aab1c5;

  cursor: pointer;

  transition: .2s;
}

.icon-button:hover {
  color: white;
  border-color: rgba(0,234,255,.35);
  box-shadow: 0 0 16px rgba(0,234,255,.08);
}

/* =========================================================
   TABS
   ========================================================= */

.tabs {
  height: 48px;
  min-height: 48px;

  padding: 0 24px;

  display: flex;
  align-items: center;
  gap: 26px;

  border-bottom: 1px solid rgba(255,255,255,.055);
}

.tab {
  height: 100%;

  display: flex;
  align-items: center;

  color: #747c95;

  font-size: 12px;
  cursor: pointer;

  position: relative;
}

.tab.active {
  color: var(--cyan);
}

.tab.active::after {
  content: "";
  position: absolute;

  left: 0;
  right: 0;
  bottom: -1px;

  height: 2px;

  background:
    linear-gradient(
      90deg,
      var(--cyan),
      var(--purple),
      var(--pink)
    );

  box-shadow:
    0 0 10px rgba(0,234,255,.6);
}

/* =========================================================
   CHAT
   ========================================================= */

.messages {
  flex: 1;
  overflow-y: auto;

  padding: 32px clamp(20px, 6vw, 100px) 140px;

  scroll-behavior: smooth;
}

.message {
  display: flex;
  gap: 13px;

  margin-bottom: 28px;

  animation: messageIn .35s ease;
}

@keyframes messageIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message.user {
  justify-content: flex-end;
}

.message-avatar {
  width: 34px;
  height: 34px;
  min-width: 34px;

  border-radius: 11px;

  display: grid;
  place-items: center;

  font-size: 11px;
  font-weight: 800;

  background: rgba(255,255,255,.055);
  border: 1px solid rgba(255,255,255,.08);
}

.message.ai .message-avatar {
  color: var(--cyan);

  border-color: rgba(0,234,255,.30);

  box-shadow:
    0 0 15px rgba(0,234,255,.08);
}

.message.user .message-avatar {
  color: white;
  background: rgba(255,255,255,.09);
}

.bubble {
  max-width: min(900px, 82%);
  padding: 15px 17px;

  border-radius: 16px;

  font-size: 13px;
  line-height: 1.7;

  white-space: pre-wrap;

  color: #e9ecf7;

  border: 1px solid rgba(255,255,255,.08);

  background:
    rgba(255,255,255,.035);
}

.message.ai .bubble {
  border-color: rgba(139,61,255,.25);

  background:
    linear-gradient(
      135deg,
      rgba(0,234,255,.035),
      rgba(139,61,255,.055),
      rgba(255,34,215,.035)
    );

  box-shadow:
    0 12px 45px rgba(0,0,0,.18);
}

.message.user .bubble {
  border-color: rgba(0,234,255,.24);

  background:
    linear-gradient(
      135deg,
      rgba(0,234,255,.09),
      rgba(45,90,255,.075)
    );
}

.message-name {
  margin-bottom: 5px;

  font-size: 11px;
  font-weight: 800;

  color: var(--cyan);
}

.message.user .message-name {
  color: #d8e5ff;
}

.message-time {
  margin-top: 6px;

  font-size: 9px;
  color: #5f667a;
}

.message-actions {
  display: flex;
  gap: 7px;
  margin-top: 7px;
}

.message-action {
  border: 0;
  background: transparent;
  color: #606981;
  cursor: pointer;
  font-size: 11px;
}

.message-action:hover {
  color: white;
}

/* =========================================================
   WELCOME
   ========================================================= */

.welcome {
  min-height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;
}

.welcome-inner {
  max-width: 650px;
}

.welcome-icon {
  width: 70px;
  height: 70px;

  margin: 0 auto 20px;

  border-radius: 22px;

  display: grid;
  place-items: center;

  font-size: 30px;

  color: var(--cyan);

  background:
    linear-gradient(
      135deg,
      rgba(0,234,255,.10),
      rgba(139,61,255,.14),
      rgba(255,34,215,.10)
    );

  border: 1px solid rgba(0,234,255,.30);

  box-shadow:
    0 0 30px rgba(0,234,255,.10),
    0 0 70px rgba(139,61,255,.08);
}

.welcome h1 {
  margin: 0;

  font-size: clamp(28px, 4vw, 44px);

  letter-spacing: -1.5px;

  background:
    linear-gradient(
      90deg,
      #ffffff,
      #a5f8ff,
      #c8a6ff,
      #ff9bed
    );

  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.welcome p {
  color: var(--muted);
  font-size: 14px;
  margin: 13px 0 0;
}

/* =========================================================
   COMPOSER
   ========================================================= */

.composer-wrap {
  position: absolute;

  left: clamp(20px, 7vw, 105px);
  right: clamp(20px, 7vw, 105px);
  bottom: 25px;

  z-index: 20;
}

.composer {
  position: relative;

  min-height: 70px;

  border-radius: 19px;

  border: 1px solid rgba(0,234,255,.22);

  background:
    linear-gradient(
      100deg,
      rgba(0,234,255,.075),
      rgba(20,20,50,.78),
      rgba(255,34,215,.07)
    );

  backdrop-filter: blur(25px) saturate(160%);
  -webkit-backdrop-filter: blur(25px) saturate(160%);

  box-shadow:
    0 0 35px rgba(0,234,255,.07),
    0 0 50px rgba(255,34,215,.035),
    inset 0 1px 0 rgba(255,255,255,.08);

  display: flex;
  align-items: flex-end;

  padding: 10px;
}

.composer::before {
  content: "";
  position: absolute;
  inset: -1px;

  border-radius: inherit;

  background:
    linear-gradient(
      90deg,
      rgba(0,234,255,.35),
      transparent 30%,
      transparent 70%,
      rgba(255,34,215,.35)
    );

  opacity: .25;

  pointer-events: none;
}

.input {
  flex: 1;

  min-height: 48px;
  max-height: 160px;

  resize: none;

  border: 0;
  outline: 0;

  background: transparent;

  color: white;

  padding: 13px 12px;

  font: inherit;
  font-size: 13px;
}

.input::placeholder {
  color: #737b91;
}

.send {
  width: 46px;
  height: 46px;

  min-width: 46px;

  border-radius: 13px;

  border: 1px solid rgba(0,234,255,.45);

  color: white;

  background:
    linear-gradient(
      135deg,
      rgba(0,234,255,.20),
      rgba(91,49,255,.25),
      rgba(255,34,215,.22)
    );

  box-shadow:
    0 0 18px rgba(0,234,255,.16),
    0 0 25px rgba(255,34,215,.08);

  cursor: pointer;

  font-size: 18px;

  transition: .25s;
}

.send:hover {
  transform: translateY(-2px);

  box-shadow:
    0 0 25px rgba(0,234,255,.30),
    0 0 35px rgba(255,34,215,.15);
}

.send:disabled {
  opacity: .45;
  cursor: default;
  transform: none;
}

.composer-footer {
  padding: 7px 5px 0;

  display: flex;
  align-items: center;

  color: #5f667a;

  font-size: 9px;
}

.disclaimer {
  text-align: center;

  color: #575e73;

  font-size: 9px;

  margin-top: 7px;
}

/* =========================================================
   LOADING
   ========================================================= */

.typing {
  display: flex;
  gap: 5px;
  padding: 6px 0;
}

.typing span {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: var(--cyan);

  box-shadow:
    0 0 8px var(--cyan);

  animation: typing 1.2s infinite;
}

.typing span:nth-child(2) {
  animation-delay: .15s;
}

.typing span:nth-child(3) {
  animation-delay: .3s;
}

@keyframes typing {
  0%,60%,100% {
    opacity: .25;
    transform: translateY(0);
  }

  30% {
    opacity: 1;
    transform: translateY(-4px);
  }
}

/* =========================================================
   EMPTY SEARCH
   ========================================================= */

.empty {
  padding: 30px 15px;
  text-align: center;
  color: #636b81;
  font-size: 12px;
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 900px) {

  .sidebar {
    position: fixed;
    z-index: 100;

    left: 10px;
    top: 10px;
    bottom: 10px;

    transform: translateX(-120%);

    transition: transform .3s ease;
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .main {
    width: 100%;
  }

  .mobile-menu {
    display: block;

    width: 36px;
    height: 36px;

    margin-right: 10px;

    border-radius: 11px;

    border: 1px solid rgba(255,255,255,.10);

    background: rgba(255,255,255,.04);

    color: white;

    cursor: pointer;
  }

  .count-pill {
    display: none;
  }

  .messages {
    padding-left: 18px;
    padding-right: 18px;
  }

  .composer-wrap {
    left: 15px;
    right: 15px;
    bottom: 15px;
  }

  .bubble {
    max-width: 88%;
  }

  .tabs {
    padding-left: 15px;
    gap: 18px;
  }
}

@media (max-width: 550px) {

  .header-title {
    font-size: 14px;
  }

  .status-pill {
    display: none;
  }

  .bubble {
    max-width: 92%;
    font-size: 12px;
  }

  .welcome h1 {
    font-size: 29px;
  }
}
</style>
</head>

<body>

<div class="app">

  <!-- =====================================================
       SIDEBAR
       ===================================================== -->

  <aside class="sidebar glass" id="sidebar">

    <div class="brand">
      <div class="logo">100→</div>

      <div>
        <div class="brand-title">100 AI Agents</div>
        <div class="brand-subtitle">
          Multi-Agent Intelligence
        </div>
      </div>
    </div>

    <button class="new-chat" id="newChat">
      ＋ New Chat
    </button>

    <div class="search-wrap">
      <span class="search-icon">⌕</span>

      <input
        id="agentSearch"
        class="search"
        type="text"
        placeholder="Search agents..."
        autocomplete="off"
      >
    </div>

    <div class="sidebar-content">

      <div class="section-title">
        Categories
      </div>

      <div class="categories" id="categories">
        <div
          class="category active"
          data-category="all"
        >
          <span>◈</span>
          <span>All Agents</span>
          <span class="category-count" id="allCount">
            101
          </span>
        </div>
      </div>

      <div class="section-title">
        All Agents
        <span id="agentCount">(101)</span>
      </div>

      <div class="agent-list" id="agentList"></div>

      <div
        id="agentEmpty"
        class="empty"
        style="display:none"
      >
        No agents found.
      </div>

    </div>

    <div class="sidebar-footer">

      <div class="online-card">

        <div class="status-dot"></div>

        <div>
          <div
            class="online-number"
            id="onlineNumber"
          >
            101 agents online
          </div>

          <div class="online-label">
            All systems operational
          </div>
        </div>

        <svg
          class="wave"
          viewBox="0 0 60 25"
          fill="none"
        >
          <path
            d="M1 14
               C4 14 4 6 8 6
               C12 6 12 19 16 19
               C20 19 20 9 24 9
               C28 9 28 16 32 16
               C36 16 36 4 40 4
               C44 4 44 19 48 19
               C52 19 52 11 59 11"
            stroke="#00f5a0"
            stroke-width="1.5"
            opacity=".8"
          />
        </svg>

      </div>

    </div>

  </aside>

  <!-- =====================================================
       MAIN
       ===================================================== -->

  <main class="main glass">

    <header class="header">

      <button
        class="mobile-menu"
        id="mobileMenu"
      >
        ☰
      </button>

      <div
        class="agent-avatar"
        id="headerAvatar"
      >
        ✦
      </div>

      <div class="header-info">

        <div
          class="header-title"
          id="headerTitle"
        >
          100 AI Agents
        </div>

        <div
          class="header-meta"
          id="headerMeta"
        >
          Multi-Agent Intelligence
        </div>

      </div>

      <div class="header-actions">

        <div class="status-pill">
          <span class="status-dot"></span>
          Gateway online
        </div>

        <div
          class="count-pill"
          id="headerCount"
        >
          101 agents online
        </div>

        <button
          class="icon-button"
          id="clearChatTop"
          title="Clear chat"
        >
          ⌫
        </button>

      </div>

    </header>

    <div class="tabs">

      <div class="tab active">
        ◌ &nbsp;Chat
      </div>

      <div class="tab">
        ⓘ &nbsp;About
      </div>

      <div class="tab">
        ⌘ &nbsp;Capabilities
      </div>

      <div class="tab">
        ↝ &nbsp;Examples
      </div>

    </div>

    <section
      class="messages"
      id="messages"
    >

      <div class="welcome">

        <div class="welcome-inner">

          <div class="welcome-icon">
            ✦
          </div>

          <h1 id="welcomeTitle">
            100 AI Agents
          </h1>

          <p id="welcomeText">
            Select an agent and start a conversation.
          </p>

        </div>

      </div>

    </section>

    <!-- =================================================
         COMPOSER
         ================================================= -->

    <div class="composer-wrap">

      <div class="composer">

        <textarea
          id="input"
          class="input"
          rows="1"
          placeholder="Message 100 AI Agents..."
        ></textarea>

        <button
          id="send"
          class="send"
          title="Send"
        >
          ↑
        </button>

      </div>

      <div class="composer-footer">

        <span>
          Enter to send · Shift + Enter for new line
        </span>

      </div>

      <div class="disclaimer">
        100 AI Agents can make mistakes. Check important information.
      </div>

    </div>

  </main>

</div>

<script>
"use strict";

/* =========================================================
   CONFIG
   ========================================================= */

const API = window.location.origin;

let agents = [];
let selectedAgent = null;
let activeCategory = "all";
let loading = false;

/* =========================================================
   DOM
   ========================================================= */

const agentList = document.getElementById("agentList");
const categories = document.getElementById("categories");
const search = document.getElementById("agentSearch");
const input = document.getElementById("input");
const send = document.getElementById("send");
const messages = document.getElementById("messages");

const headerTitle = document.getElementById("headerTitle");
const headerMeta = document.getElementById("headerMeta");
const headerAvatar = document.getElementById("headerAvatar");

const welcomeTitle = document.getElementById("welcomeTitle");
const welcomeText = document.getElementById("welcomeText");

const agentCount = document.getElementById("agentCount");
const allCount = document.getElementById("allCount");
const onlineNumber = document.getElementById("onlineNumber");
const headerCount = document.getElementById("headerCount");

const sidebar = document.getElementById("sidebar");

/* =========================================================
   LOAD AGENTS
   ========================================================= */

async function loadAgents() {

  try {

    const response = await fetch(
      API + "/api/agents",
      {
        cache: "no-store"
      }
    );

    if (!response.ok) {
      throw new Error(
        "Failed to load agents"
      );
    }

    const data = await response.json();

    agents =
      Array.isArray(data.agents)
        ? data.agents
        : [];

    renderCategories();
    renderAgents();

    const saved =
      localStorage.getItem(
        "100ai-selected-agent"
      );

    const found =
      agents.find(
        a => a.agent_id === saved
      );

    if (found) {
      selectAgent(found.agent_id);
    } else if (agents.length) {
      selectAgent(agents[0].agent_id);
    }

  } catch (error) {

    console.error(error);

    agentList.innerHTML = `
      <div class="empty">
        Unable to load agents.
      </div>
    `;

  }

}

/* =========================================================
   CATEGORIES
   ========================================================= */

function renderCategories() {

  const map = new Map();

  agents.forEach(agent => {

    const category =
      agent.category ||
      "general";

    map.set(
      category,
      (map.get(category) || 0) + 1
    );

  });

  categories.innerHTML = `
    <div
      class="category ${activeCategory === "all" ? "active" : ""}"
      data-category="all"
    >
      <span>◈</span>
      <span>All Agents</span>
      <span class="category-count">
        ${agents.length}
      </span>
    </div>
  `;

  [...map.entries()]
    .sort((a,b) => a[0].localeCompare(b[0]))
    .forEach(
      ([category,count]) => {

        const el =
          document.createElement("div");

        el.className =
          "category " +
          (
            activeCategory === category
              ? "active"
              : ""
          );

        el.dataset.category =
          category;

        el.innerHTML = `
          <span>◈</span>
          <span>${escapeHtml(category)}</span>
          <span class="category-count">
            ${count}
          </span>
        `;

        categories.appendChild(el);

      }
    );

}

/* =========================================================
   AGENT LIST
   ========================================================= */

function renderAgents() {

  const query =
    search.value
      .trim()
      .toLowerCase();

  const filtered =
    agents.filter(agent => {

      const category =
        agent.category ||
        "general";

      const categoryMatch =
        activeCategory === "all" ||
        category === activeCategory;

      const searchable =
        [
          agent.name,
          agent.agent_id,
          agent.slug,
          agent.category
        ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();

      const searchMatch =
        !query ||
        searchable.includes(query);

      return categoryMatch &&
             searchMatch;

    });

  agentList.innerHTML = "";

  agentCount.textContent =
    `(${filtered.length})`;

  if (!filtered.length) {

    document.getElementById(
      "agentEmpty"
    ).style.display = "block";

    return;

  }

  document.getElementById(
    "agentEmpty"
  ).style.display = "none";

  filtered.forEach(agent => {

    const item =
      document.createElement("div");

    item.className =
      "agent " +
      (
        selectedAgent &&
        selectedAgent.agent_id === agent.agent_id
          ? "active"
          : ""
      );

    item.dataset.id =
      agent.agent_id;

    item.innerHTML = `
      <span class="status-dot"></span>

      <div class="agent-info">

        <div class="agent-name">
          ${escapeHtml(
            agent.name ||
            agent.agent_id
          )}
        </div>

        <div class="agent-meta">
          ${escapeHtml(
            agent.agent_id
          )}
          ·
          ${escapeHtml(
            agent.category ||
            "general"
          )}
        </div>

      </div>
    `;

    item.addEventListener(
      "click",
      () => {

        selectAgent(
          agent.agent_id
        );

        if (
          window.innerWidth <= 900
        ) {
          sidebar.classList.remove(
            "open"
          );
        }

      }
    );

    agentList.appendChild(item);

  });

}

/* =========================================================
   SELECT AGENT
   ========================================================= */

function selectAgent(id) {

  const agent =
    agents.find(
      a => a.agent_id === id
    );

  if (!agent) return;

  selectedAgent = agent;

  localStorage.setItem(
    "100ai-selected-agent",
    id
  );

  headerTitle.textContent =
    agent.name || id;

  headerMeta.textContent =
    `${agent.agent_id} · ${agent.category || "general"}`;

  headerAvatar.textContent = "✦";

  welcomeTitle.textContent =
    agent.name || "AI Agent";

  welcomeText.textContent =
    `Ask anything related to ${agent.name || "this agent"}'s specialty.`;

  input.placeholder =
    `Message ${agent.name || "AI Agent"}...`;

  renderAgents();

  loadConversation();

}

/* =========================================================
   CHAT STORAGE
   ========================================================= */

function storageKey() {

  return (
    "100ai-chat-" +
    (
      selectedAgent
        ? selectedAgent.agent_id
        : "none"
    )
  );

}

function getHistory() {

  try {

    return JSON.parse(
      localStorage.getItem(
        storageKey()
      ) || "[]"
    );

  } catch {

    return [];

  }

}

function saveHistory(history) {

  localStorage.setItem(
    storageKey(),
    JSON.stringify(history)
  );

}

/* =========================================================
   LOAD CONVERSATION
   ========================================================= */

function loadConversation() {

  const history =
    getHistory();

  messages.innerHTML = "";

  if (!history.length) {

    messages.innerHTML = `
      <div class="welcome">

        <div class="welcome-inner">

          <div class="welcome-icon">
            ✦
          </div>

          <h1>
            ${escapeHtml(
              selectedAgent?.name ||
              "100 AI Agents"
            )}
          </h1>

          <p>
            Ask anything related to this
            agent's specialty.
          </p>

        </div>

      </div>
    `;

    return;

  }

  history.forEach(message => {

    addMessage(
      message.role,
      message.content,
      false
    );

  });

  scrollBottom();

}

/* =========================================================
   ADD MESSAGE
   ========================================================= */

function addMessage(
  role,
  content,
  save = true
) {

  const welcome =
    messages.querySelector(
      ".welcome"
    );

  if (welcome) {
    welcome.remove();
  }

  const wrapper =
    document.createElement("div");

  wrapper.className =
    "message " +
    (
      role === "user"
        ? "user"
        : "ai"
    );

  const avatar =
    role === "user"
      ? "You"
      : "AI";

  const name =
    role === "user"
      ? "You"
      : (
          selectedAgent?.name ||
          "AI Agent"
        );

  wrapper.innerHTML = `
    ${
      role === "user"
        ? ""
        : `
          <div class="message-avatar">
            ${avatar}
          </div>
        `
    }

    <div>

      <div class="bubble">

        <div class="message-name">
          ${escapeHtml(name)}
        </div>

        <div class="message-content">
          ${formatText(content)}
        </div>

      </div>

      <div class="message-time">
        ${new Date().toLocaleTimeString(
          [],
          {
            hour: "2-digit",
            minute: "2-digit"
          }
        )}
      </div>

      ${
        role === "assistant" ||
        role === "ai"
          ? `
            <div class="message-actions">
              <button
                class="message-action copy-btn"
              >
                Copy
              </button>
            </div>
          `
          : ""
      }

    </div>

    ${
      role === "user"
        ? `
          <div class="message-avatar">
            ${avatar}
          </div>
        `
        : ""
    }
  `;

  messages.appendChild(wrapper);

  const copy =
    wrapper.querySelector(
      ".copy-btn"
    );

  if (copy) {

    copy.addEventListener(
      "click",
      async () => {

        await navigator.clipboard.writeText(
          content
        );

        copy.textContent =
          "Copied";

        setTimeout(
          () => {
            copy.textContent =
              "Copy";
          },
          1200
        );

      }
    );

  }

  if (save) {

    const history =
      getHistory();

    history.push({
      role,
      content
    });

    saveHistory(history);

  }

}

/* =========================================================
   SEND MESSAGE
   ========================================================= */

async function sendMessage() {

  if (loading) return;

  const task =
    input.value.trim();

  if (!task) return;

  if (!selectedAgent) {

    alert(
      "Please select an agent first."
    );

    return;

  }

  loading = true;

  send.disabled = true;

  input.value = "";

  resizeInput();

  addMessage(
    "user",
    task
  );

  const loadingMessage =
    document.createElement("div");

  loadingMessage.className =
    "message ai";

  loadingMessage.innerHTML = `
    <div class="message-avatar">
      AI
    </div>

    <div>

      <div class="bubble">

        <div class="message-name">
          ${escapeHtml(
            selectedAgent.name
          )}
        </div>

        <div class="typing">
          <span></span>
          <span></span>
          <span></span>
        </div>

      </div>

    </div>
  `;

  messages.appendChild(
    loadingMessage
  );

  scrollBottom();

  try {

    const response =
      await fetch(
        API + "/api/chat",
        {
          method: "POST",

          headers: {
            "Content-Type":
              "application/json"
          },

          body: JSON.stringify({
            agent_id:
              selectedAgent.agent_id,

            task,

            context: {},

            parameters: {},

            output_format: "text"
          })
        }
      );

    const data =
      await response.json();

    loadingMessage.remove();

    let result = "";

    if (
      data &&
      data.result
    ) {

      if (
        typeof data.result ===
        "string"
      ) {

        result =
          data.result;

      } else {

        result =
          data.result.result ||
          data.result.response ||
          JSON.stringify(
            data.result,
            null,
            2
          );

      }

    }

    if (!result) {

      result =
        data.error ||
        "The agent returned an empty response.";

    }

    addMessage(
      "assistant",
      result
    );

  } catch (error) {

    loadingMessage.remove();

    addMessage(
      "assistant",
      "Unable to connect to the 100 AI Agents gateway.\n\n" +
      error.message
    );

  } finally {

    loading = false;

    send.disabled = false;

    input.focus();

    scrollBottom();

  }

}

/* =========================================================
   NEW CHAT
   ========================================================= */

function newChat() {

  if (!selectedAgent) return;

  localStorage.removeItem(
    storageKey()
  );

  loadConversation();

  input.focus();

}

/* =========================================================
   CLEAR
   ========================================================= */

document
  .getElementById("clearChatTop")
  .addEventListener(
    "click",
    newChat
  );

document
  .getElementById("newChat")
  .addEventListener(
    "click",
    newChat
  );

/* =========================================================
   CATEGORY CLICK
   ========================================================= */

categories.addEventListener(
  "click",
  event => {

    const category =
      event.target.closest(
        ".category"
      );

    if (!category) return;

    activeCategory =
      category.dataset.category;

    renderCategories();
    renderAgents();

  }
);

/* =========================================================
   SEARCH
   ========================================================= */

search.addEventListener(
  "input",
  renderAgents
);

/* =========================================================
   SEND BUTTON
   ========================================================= */

send.addEventListener(
  "click",
  sendMessage
);

/* =========================================================
   KEYBOARD
   ========================================================= */

input.addEventListener(
  "keydown",
  event => {

    if (
      event.key === "Enter" &&
      !event.shiftKey
    ) {

      event.preventDefault();

      sendMessage();

    }

  }
);

/* =========================================================
   AUTO RESIZE
   ========================================================= */

input.addEventListener(
  "input",
  resizeInput
);

function resizeInput() {

  input.style.height =
    "auto";

  input.style.height =
    Math.min(
      input.scrollHeight,
      160
    ) + "px";

}

/* =========================================================
   MOBILE
   ========================================================= */

document
  .getElementById("mobileMenu")
  .addEventListener(
    "click",
    () => {

      sidebar.classList.toggle(
        "open"
      );

    }
  );

/* =========================================================
   SCROLL
   ========================================================= */

function scrollBottom() {

  requestAnimationFrame(
    () => {

      messages.scrollTop =
        messages.scrollHeight;

    }
  );

}

/* =========================================================
   FORMAT TEXT
   ========================================================= */

function formatText(text) {

  let html =
    escapeHtml(
      String(text ?? "")
    );

  html =
    html.replace(
      /```([\s\S]*?)```/g,
      "<pre style=\"" +
      "overflow:auto;" +
      "padding:12px;" +
      "border-radius:10px;" +
      "background:rgba(0,0,0,.35);" +
      "border:1px solid rgba(255,255,255,.08);" +
      "\">$1</pre>"
    );

  html =
    html.replace(
      /\*\*(.*?)\*\*/g,
      "<strong>$1</strong>"
    );

  html =
    html.replace(
      /^### (.*)$/gm,
      "<strong style=\"color:#00eaff\">$1</strong>"
    );

  html =
    html.replace(
      /\n/g,
      "<br>"
    );

  return html;

}

/* =========================================================
   ESCAPE
   ========================================================= */

function escapeHtml(value) {

  return String(value ?? "")
    .replace(
      /&/g,
      "&amp;"
    )
    .replace(
      /</g,
      "&lt;"
    )
    .replace(
      />/g,
      "&gt;"
    )
    .replace(
      /"/g,
      "&quot;"
    )
    .replace(
      /'/g,
      "&#039;"
    );

}

/* =========================================================
   INIT
   ========================================================= */

loadAgents();

</script>

</body>
</html>
