<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>100-to-1 AI</title>

<style>
* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

body {
  background: #ffffff;
  color: #171717;
}

.app {
  display: flex;
  width: 100%;
  height: 100vh;
}

/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar {
  width: 280px;
  background: #f7f7f8;
  border-right: 1px solid #e5e5e5;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.brand {
  padding: 18px 18px 12px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  background: #171717;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 15px;
}

.brand-text {
  font-size: 16px;
  font-weight: 700;
}

.brand-sub {
  color: #737373;
  font-size: 11px;
  margin-top: 2px;
}

.new-chat {
  margin: 8px 14px 14px;
  padding: 11px 13px;
  border: 1px solid #d8d8d8;
  background: #ffffff;
  border-radius: 9px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  text-align: left;
}

.new-chat:hover {
  background: #eeeeee;
}

.sidebar-section {
  padding: 0 12px;
  flex: 1;
  overflow-y: auto;
}

.section-title {
  color: #8a8a8a;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .05em;
  padding: 8px 8px;
}

.agent-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.agent {
  border: 0;
  width: 100%;
  background: transparent;
  border-radius: 8px;
  padding: 9px 10px;
  cursor: pointer;
  text-align: left;
  display: flex;
  align-items: center;
  gap: 9px;
}

.agent:hover {
  background: #ececec;
}

.agent.active {
  background: #e3e3e3;
}

.agent-dot {
  width: 8px;
  height: 8px;
  background: #10a37f;
  border-radius: 50%;
  flex-shrink: 0;
}

.agent-info {
  min-width: 0;
}

.agent-name {
  font-size: 13px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.agent-id {
  color: #888;
  font-size: 10px;
  margin-top: 2px;
}

.sidebar-bottom {
  border-top: 1px solid #e5e5e5;
  padding: 12px 14px;
}

.system-status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #555;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #10a37f;
}

/* =========================================================
   MAIN
   ========================================================= */

.main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.topbar {
  height: 58px;
  border-bottom: 1px solid #eeeeee;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22px;
}

.current-agent {
  display: flex;
  align-items: center;
  gap: 9px;
}

.current-agent-name {
  font-size: 15px;
  font-weight: 650;
}

.current-agent-meta {
  font-size: 11px;
  color: #888;
}

.gateway-status {
  font-size: 11px;
  color: #10a37f;
}

.chat {
  flex: 1;
  overflow-y: auto;
  padding: 32px 20px 140px;
}

.chat-inner {
  width: 100%;
  max-width: 820px;
  margin: 0 auto;
}

.welcome {
  text-align: center;
  margin-top: 15vh;
}

.welcome h1 {
  margin: 0 0 10px;
  font-size: 30px;
  font-weight: 650;
}

.welcome p {
  margin: 0;
  color: #737373;
  font-size: 14px;
}

.message {
  display: flex;
  gap: 14px;
  margin: 28px 0;
}

.avatar {
  width: 30px;
  height: 30px;
  border-radius: 7px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
}

.message.user .avatar {
  background: #171717;
  color: white;
}

.message.assistant .avatar {
  background: #10a37f;
  color: white;
}

.message-content {
  flex: 1;
  min-width: 0;
  line-height: 1.65;
  font-size: 14px;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.message-role {
  font-size: 12px;
  font-weight: 650;
  margin-bottom: 4px;
}

.message-meta {
  margin-top: 8px;
  color: #999;
  font-size: 10px;
}

/* =========================================================
   COMPOSER
   ========================================================= */

.composer-wrap {
  position: fixed;
  bottom: 0;
  left: 280px;
  right: 0;
  padding: 20px;
  background: linear-gradient(
    transparent,
    #ffffff 30%
  );
}

.composer {
  max-width: 820px;
  margin: 0 auto;
  border: 1px solid #d9d9d9;
  border-radius: 15px;
  background: #ffffff;
  box-shadow: 0 3px 18px rgba(0,0,0,.07);
  display: flex;
  align-items: flex-end;
  padding: 9px;
}

textarea {
  flex: 1;
  border: 0;
  outline: 0;
  resize: none;
  min-height: 42px;
  max-height: 180px;
  padding: 10px 12px;
  font: inherit;
  font-size: 14px;
  line-height: 1.45;
}

.send {
  width: 40px;
  height: 40px;
  border: 0;
  border-radius: 10px;
  background: #171717;
  color: white;
  cursor: pointer;
  font-size: 18px;
}

.send:hover {
  background: #333;
}

.send:disabled {
  opacity: .45;
  cursor: default;
}

.composer-hint {
  max-width: 820px;
  margin: 7px auto 0;
  text-align: center;
  color: #999;
  font-size: 10px;
}

/* =========================================================
   LOADING
   ========================================================= */

.typing {
  display: inline-flex;
  gap: 4px;
  padding: 8px 0;
}

.typing span {
  width: 6px;
  height: 6px;
  background: #999;
  border-radius: 50%;
  animation: bounce 1.2s infinite;
}

.typing span:nth-child(2) {
  animation-delay: .15s;
}

.typing span:nth-child(3) {
  animation-delay: .3s;
}

@keyframes bounce {
  0%, 60%, 100% {
    transform: translateY(0);
  }

  30% {
    transform: translateY(-5px);
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 800px) {
  .sidebar {
    width: 230px;
  }

  .composer-wrap {
    left: 230px;
  }
}

@media (max-width: 650px) {
  .sidebar {
    display: none;
  }

  .composer-wrap {
    left: 0;
  }

  .topbar {
    padding: 0 14px;
  }

  .chat {
    padding-left: 14px;
    padding-right: 14px;
  }
}
</style>
</head>

<body>

<div class="app">

  <aside class="sidebar">

    <div class="brand">
      <div class="brand-icon">1→</div>
      <div>
        <div class="brand-text">100-to-1 AI</div>
        <div class="brand-sub">Multi-Agent Intelligence</div>
      </div>
    </div>

    <button class="new-chat" onclick="newChat()">
      ＋ New chat
    </button>

    <div class="sidebar-section">

      <div class="section-title">
        Agents
      </div>

      <div id="agentList" class="agent-list">
        <div style="padding:15px;color:#999;font-size:12px">
          Loading agents...
        </div>
      </div>

    </div>

    <div class="sidebar-bottom">

      <div class="system-status">
        <span id="statusDot" class="status-dot"></span>
        <span id="systemStatus">
          Connecting to gateway...
        </span>
      </div>

    </div>

  </aside>


  <main class="main">

    <header class="topbar">

      <div class="current-agent">

        <div>
          <div id="currentAgentName" class="current-agent-name">
            100-to-1 AI
          </div>

          <div id="currentAgentMeta" class="current-agent-meta">
            Select an agent
          </div>
        </div>

      </div>

      <div id="gatewayStatus" class="gateway-status">
        Gateway
      </div>

    </header>


    <section id="chat" class="chat">

      <div id="chatInner" class="chat-inner">

        <div id="welcome" class="welcome">

          <h1>How can I help you?</h1>

          <p>
            Select one of the 101 specialized AI agents and start a conversation.
          </p>

        </div>

      </div>

    </section>


    <div class="composer-wrap">

      <div class="composer">

        <textarea
          id="input"
          placeholder="Message 100-to-1 AI..."
          rows="1"
          disabled
        ></textarea>

        <button
          id="send"
          class="send"
          onclick="sendMessage()"
          disabled
        >
          ↑
        </button>

      </div>

      <div class="composer-hint">
        100-to-1 AI can make mistakes. Check important information.
      </div>

    </div>

  </main>

</div>


<script>
const state = {
  agents: [],
  selectedAgent: null,
  messages: [],
  busy: false
};


function $(id) {
  return document.getElementById(id);
}


/* =========================================================
   LOAD AGENTS
   ========================================================= */

async function loadAgents() {

  try {

    const response = await fetch("/api/agents");

    if (!response.ok) {
      throw new Error("Gateway returned " + response.status);
    }

    const data = await response.json();

    state.agents = Array.isArray(data.agents)
      ? data.agents
      : [];

    renderAgents();

    if (state.agents.length > 0) {
      selectAgent(state.agents[0]);
    }

    $("statusDot").style.background = "#10a37f";
    $("systemStatus").textContent =
      `${state.agents.length} agents online`;

    $("gatewayStatus").textContent =
      "● Gateway online";

  } catch (error) {

    console.error(error);

    $("statusDot").style.background = "#ef4444";

    $("systemStatus").textContent =
      "Gateway connection failed";

    $("gatewayStatus").textContent =
      "● Gateway offline";

    $("agentList").innerHTML = `
      <div style="padding:12px;color:#b91c1c;font-size:12px">
        Unable to load agents.
      </div>
    `;
  }
}


/* =========================================================
   RENDER AGENTS
   ========================================================= */

function renderAgents() {

  const list = $("agentList");

  list.innerHTML = "";

  for (const agent of state.agents) {

    const button = document.createElement("button");

    button.className =
      "agent" +
      (
        state.selectedAgent &&
        state.selectedAgent.agent_id === agent.agent_id
          ? " active"
          : ""
      );

    button.onclick = () => selectAgent(agent);

    button.innerHTML = `
      <span class="agent-dot"></span>

      <span class="agent-info">

        <span class="agent-name">
          ${escapeHtml(agent.name || agent.agent_name || agent.agent_id)}
        </span>

        <span class="agent-id">
          ${escapeHtml(agent.agent_id || "")}
          ${agent.category ? " · " + escapeHtml(agent.category) : ""}
        </span>

      </span>
    `;

    list.appendChild(button);
  }
}


/* =========================================================
   SELECT AGENT
   ========================================================= */

function selectAgent(agent) {

  state.selectedAgent = agent;
  state.messages = [];

  renderAgents();

  const name =
    agent.name ||
    agent.agent_name ||
    agent.agent_id;

  $("currentAgentName").textContent = name;

  $("currentAgentMeta").textContent =
    `${agent.agent_id || ""} · ${agent.category || "AI agent"}`;

  $("input").disabled = false;
  $("send").disabled = false;

  $("input").placeholder =
    `Message ${name}...`;

  renderChat();
}


/* =========================================================
   NEW CHAT
   ========================================================= */

function newChat() {

  state.messages = [];

  renderChat();

  $("input").focus();
}


/* =========================================================
   SEND MESSAGE
   ========================================================= */

async function sendMessage() {

  if (state.busy) {
    return;
  }

  if (!state.selectedAgent) {
    return;
  }

  const input = $("input");

  const task = input.value.trim();

  if (!task) {
    return;
  }

  state.messages.push({
    role: "user",
    content: task
  });

  input.value = "";

  autoResize();

  renderChat();

  state.busy = true;

  $("send").disabled = true;

  addTyping();

  try {

    const response = await fetch("/api/chat", {

      method: "POST",

      headers: {
        "Content-Type": "application/json"
      },

      body: JSON.stringify({

        agent_id:
          state.selectedAgent.agent_id,

        task,

        context: {},

        parameters: {},

        output_format: "text"

      })

    });


    const data = await response.json();


    removeTyping();


    if (!response.ok) {

      throw new Error(
        data.error ||
        "Gateway request failed"
      );

    }


    let result = data.result;


    if (
      result &&
      typeof result === "object" &&
      typeof result.result === "string"
    ) {
      result = result.result;
    }


    if (
      typeof result !== "string"
    ) {
      result = JSON.stringify(
        result,
        null,
        2
      );
    }


    state.messages.push({

      role: "assistant",

      content: result,

      metadata:
        data.result &&
        data.result.metadata
          ? data.result.metadata
          : null

    });


  } catch (error) {

    removeTyping();

    state.messages.push({

      role: "assistant",

      content:
        "Error: " +
        error.message

    });

  }


  state.busy = false;

  $("send").disabled = false;

  renderChat();

  input.focus();
}


/* =========================================================
   RENDER CHAT
   ========================================================= */

function renderChat() {

  const inner = $("chatInner");

  if (!state.messages.length) {

    inner.innerHTML = `
      <div id="welcome" class="welcome">

        <h1>
          ${state.selectedAgent
            ? escapeHtml(
                state.selectedAgent.name ||
                state.selectedAgent.agent_name ||
                "AI Agent"
              )
            : "How can I help you?"
          }
        </h1>

        <p>
          ${
            state.selectedAgent
              ? "Ask anything related to this agent's specialty."
              : "Select one of the 101 specialized AI agents and start a conversation."
          }
        </p>

      </div>
    `;

    return;
  }


  inner.innerHTML = "";


  for (const message of state.messages) {

    const div = document.createElement("div");

    div.className =
      "message " +
      message.role;


    const avatar =
      message.role === "user"
        ? "You"
        : "AI";


    const role =
      message.role === "user"
        ? "You"
        : (
          state.selectedAgent
            ? (
              state.selectedAgent.name ||
              state.selectedAgent.agent_name ||
              "AI"
            )
            : "AI"
        );


    const metadata =
      message.metadata
        ? `
          <div class="message-meta">
            ${message.metadata.model
              ? "Model: " +
                escapeHtml(message.metadata.model)
              : ""}
            ${
              message.metadata.duration_ms
                ? " · " +
                  message.metadata.duration_ms +
                  " ms"
                : ""
            }
          </div>
        `
        : "";


    div.innerHTML = `

      <div class="avatar">
        ${escapeHtml(avatar)}
      </div>

      <div class="message-content">

        <div class="message-role">
          ${escapeHtml(role)}
        </div>

        <div>
          ${formatText(message.content)}
        </div>

        ${metadata}

      </div>

    `;


    inner.appendChild(div);
  }


  scrollToBottom();
}


/* =========================================================
   TYPING
   ========================================================= */

function addTyping() {

  const inner = $("chatInner");

  const div = document.createElement("div");

  div.id = "typing";

  div.className =
    "message assistant";

  div.innerHTML = `

    <div class="avatar">
      AI
    </div>

    <div class="message-content">

      <div class="message-role">
        ${
          state.selectedAgent
            ? escapeHtml(
                state.selectedAgent.name ||
                state.selectedAgent.agent_name ||
                "AI"
              )
            : "AI"
        }
      </div>

      <div class="typing">
        <span></span>
        <span></span>
        <span></span>
      </div>

    </div>
  `;

  inner.appendChild(div);

  scrollToBottom();
}


function removeTyping() {

  const typing = $("typing");

  if (typing) {
    typing.remove();
  }
}


/* =========================================================
   HELPERS
   ========================================================= */

function escapeHtml(value) {

  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}


function formatText(value) {

  return escapeHtml(value)
    .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\n/g, "<br>");
}


function scrollToBottom() {

  requestAnimationFrame(() => {

    const chat = $("chat");

    chat.scrollTop =
      chat.scrollHeight;

  });
}


function autoResize() {

  const input = $("input");

  input.style.height = "auto";

  input.style.height =
    Math.min(
      input.scrollHeight,
      180
    ) + "px";
}


/* =========================================================
   KEYBOARD
   ========================================================= */

$("input").addEventListener(
  "input",
  autoResize
);


$("input").addEventListener(
  "keydown",
  event => {

    if (
      event.key === "Enter" &&
      !event.shiftKey
    ) {

      event.preventDefault();

      sendMessage();
    }
  }
);


/* =========================================================
   START
   ========================================================= */

loadAgents();

</script>

</body>
</html>
